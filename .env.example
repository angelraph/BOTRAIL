# --- AI ---
OPENAI_API_KEY=

# --- Chain ---
# Local dev: point at a running `anvil` instance (default RPC below).
# Mainnet: replace with BOT Chain's mainnet RPC URL (chain ID 677) once available.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Attester wallet: the backend signer that writes AI verdicts and drives
# escrow releases on-chain. NEVER commit a real private key. For local
# Anvil dev, use one of the default funded test keys Anvil prints on boot.
ATTESTER_PRIVATE_KEY=

# Filled in after `forge script script/Deploy.s.sol --broadcast`
ASSET_REGISTRY_ADDRESS=
SETTLEMENT_ESCROW_ADDRESS=

# --- App DB ---
DATABASE_URL="file:./dev.db"
